HF_TOKEN=__hf_token__

# ── Model profile (exactly ONE block active) ─────────────────────────
# Switch: comment OUT the active block, comment IN the other.
# Download once per profile: ./dc.sh download
# Then restart serve:        ./dc.sh restart
# MTP / mmproj in HF_* are optional — leave empty to skip that download.
HF_MODEL_REVISION=main
HF_MTP_MODEL_REVISION=main
HF_MMPROJ_MODEL_REVISION=main
# OpenAI API model id (clients use this in `model:`). Empty → "Qwen3.8 Flash Next"
GUFO_SERVED_MODEL_NAME=flash-next

# --- A) Unsloth (normal / original) — default ---
HF_REPO=unsloth/Qwen3.8-Flash-Next-GGUF
HF_MODEL_FILES=UD-IQ4_XS/Qwen3.8-Flash-Next-UD-IQ4_XS-00001-of-00003.gguf UD-IQ4_XS/Qwen3.8-Flash-Next-UD-IQ4_XS-00002-of-00003.gguf UD-IQ4_XS/Qwen3.8-Flash-Next-UD-IQ4_XS-00003-of-00003.gguf
HF_MTP_MODEL=MTP/mtp-Qwen3.8-Flash-Next-shared-Q8_0.gguf
HF_MMPROJ_MODEL=mmproj-BF16.gguf
GUFO_MODEL=/models/Qwen3.8-Flash-Next-GGUF/UD-IQ4_XS/Qwen3.8-Flash-Next-UD-IQ4_XS-00001-of-00003.gguf
GUFO_MTP=/models/Qwen3.8-Flash-Next-GGUF/MTP/mtp-Qwen3.8-Flash-Next-shared-Q8_0.gguf
GUFO_MMPROJ=/models/Qwen3.8-Flash-Next-GGUF/mmproj-BF16.gguf

# --- B) Huihui abliterated v2 ---
# HF_REPO=huihui-ai/Huihui-Qwen3.8-Flash-Next-abliterated-v2-GGUF
# HF_MODEL_FILES=unsloth-UD-IQ4_XS/Qwen3.8-Flash-Next-UD-IQ4_XS-00001-of-00003.gguf unsloth-UD-IQ4_XS/Qwen3.8-Flash-Next-UD-IQ4_XS-00002-of-00003.gguf unsloth-UD-IQ4_XS/Qwen3.8-Flash-Next-UD-IQ4_XS-00003-of-00003.gguf
# HF_MTP_MODEL=
# HF_MMPROJ_MODEL=mmproj-Qwen3.8-Flash-Next-BF16.gguf
# GUFO_MODEL=/models/Huihui-Qwen3.8-Flash-Next-abliterated-v2-GGUF/unsloth-UD-IQ4_XS/Qwen3.8-Flash-Next-UD-IQ4_XS-00001-of-00003.gguf
# GUFO_MTP=/models/Qwen3.8-Flash-Next-GGUF/MTP/mtp-Qwen3.8-Flash-Next-shared-Q8_0.gguf
# GUFO_MMPROJ=/models/Huihui-Qwen3.8-Flash-Next-abliterated-v2-GGUF/mmproj-Qwen3.8-Flash-Next-BF16.gguf

MODELS_DIR=./models
HF_DOWNLOADER_TAG=latest
FLASH_NEXT_PORT=8900
FLASH_NEXT_TAG=gufo-fork-enhancements

# Serve context window in tokens (KV-cache memory scales with this size).
# Default 131072 (128K). The model supports up to 262144 (256K), but
# doubling the window roughly doubles KV-cache usage — raise only if VRAM
# allows, otherwise expect load/serve crashes.
# GUFO_CONTEXT=262144

# 1 = enable NPU path (fabric-clock service holds GPU fabric clock before
# serve; still needs /dev/accel + non-turbo mode). 0 = GPU-only.
# See docs/troubleshoot-npu.md and gufo docs/NPU.md.
GUFO_NPU=0

# NPU power mode applied at serve start via xrt-smi (needs GUFO_NPU=1).
# performance|balanced|default|powersaver — never turbo. Empty = leave unchanged.
# Mode resets on every driver load / reboot.
GUFO_NPU_PMODE=performance

# Prefill tile in tokens (scratch memory ~3 GiB at 8192, ~9 GiB at 16384).
# Fork docs default to 16384; 8192 is safer when GUFO_CONTEXT is large.
GUFO_PREFILL_TILE=8192

# Optional monitoring (docker-compose.override.yml: prometheus + grafana).
# Grafana is published via tsdproxy as hostname "grafana".
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Build-time (_build.yml): fork branch and optional NPU compile
# GUFO_REF=fork-enhancements
# Build uses libxrt-dev from ppa:amd-team/xrt (override only for custom XRT layouts)
# GUFO_XRT_INCLUDE_DIR=/usr/include
# GUFO_XRT_LIB_DIR=/usr/lib/x86_64-linux-gnu
