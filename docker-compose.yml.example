# gufo serving Qwen3.8 Flash-Next (UD-IQ4_XS + optional MTP + mmproj for images).
# Setup: ./dc.sh init   (and optionally ./dc.sh init:override for tsdproxy)
# Build: ./dc.sh build
# Models: ./dc.sh download
# Run:   set GUFO_MODEL / GUFO_MTP / GUFO_MMPROJ in .env, then ./dc.sh up

services:
  # One-shot HF weight fetch — enabled only with profile "init"
  # (./dc.sh init / ./dc.sh download). Not started by plain `compose up`.
  model-download:
    profiles:
      - init
    env_file:
      - .env
    build:
      context: src/model-download
      dockerfile: Dockerfile
    image: harianto/hf-downloader:${HF_DOWNLOADER_TAG:-latest}
    working_dir: /workspace
    volumes:
      - "${MODELS_DIR:-./models}:/workspace/models"
    environment:
      HF_TOKEN: ${HF_TOKEN:-}
    command:
      - sh
      - -ec
      - |
        dest="/workspace/models/$$(basename "$$HF_REPO")"
        for shard in \
          UD-IQ4_XS/Qwen3.8-Flash-Next-UD-IQ4_XS-00001-of-00003.gguf \
          UD-IQ4_XS/Qwen3.8-Flash-Next-UD-IQ4_XS-00002-of-00003.gguf \
          UD-IQ4_XS/Qwen3.8-Flash-Next-UD-IQ4_XS-00003-of-00003.gguf
        do
          hf download "$$HF_REPO" "$$shard" \
            --revision "$$HF_MODEL_REVISION" \
            --repo-type model \
            --local-dir "$$dest"
        done
        hf download "$$HF_REPO" "$$HF_MTP_MODEL" \
          --revision "$$HF_MTP_MODEL_REVISION" \
          --repo-type model \
          --local-dir "$$dest"
        hf download "$$HF_REPO" "$${HF_MMPROJ_MODEL:-mmproj-BF16.gguf}" \
          --revision "$${HF_MMPROJ_MODEL_REVISION:-$$HF_MODEL_REVISION}" \
          --repo-type model \
          --local-dir "$$dest"

  # One-shot init for the NPU path: pins the GPU fabric clock (pp_dpm_fclk)
  # at its top level before flash-next starts, then exits. Needs privileged
  # sysfs write access. The clock resets at reboot; `compose down` does not
  # revert it (run fabric-clock.sh release manually if needed).
  fabric-clock:
    image: harianto/flash-next:${FLASH_NEXT_TAG:-gufo-fork-enhancements}
    privileged: true
    # Separate container: pass GPU nodes so amdgpu sysfs (pp_dpm_fclk) is
    # reliably present. /dev/accel is only needed by flash-next for NPU serve.
    devices:
      - /dev/kfd
      - /dev/dri
    entrypoint: ["/opt/gufo/tools/npu/fabric-clock.sh"]
    command: ["hold"]
    restart: "no"

  flash-next:
    container_name: flash-next
    image: harianto/flash-next:${FLASH_NEXT_TAG:-gufo-fork-enhancements}
    privileged: true
    group_add:
      - "${VIDEO_GID:-26}"
      - "${RENDER_GID:-383}"
    devices:
      - /dev/kfd
      - /dev/dri
      - /dev/accel/accel0
    depends_on:
      fabric-clock:
        condition: service_completed_successfully
    security_opt:
      - seccomp:unconfined
      - apparmor:unconfined
    shm_size: "8gb"
    ports:
      - "${FLASH_NEXT_PORT:-8900}:8900"
    volumes:
      - flash-next-cache:/root/.cache/gufo
      - "${MODELS_DIR:-./models}:/models:ro"
      # Pick up serve-script changes without a full image rebuild.
      - ./src/flash-next/docker-serve.sh:/usr/local/bin/docker-serve.sh:ro
    environment:
      GUFO_MODEL: "${GUFO_MODEL:?set GUFO_MODEL to the first UD-IQ4_XS shard}"
      GUFO_MTP: "${GUFO_MTP:-}"
      GUFO_MMPROJ: "${GUFO_MMPROJ:-/models/Qwen3.8-Flash-Next-GGUF/mmproj-BF16.gguf}"
      PORT: "${FLASH_NEXT_PORT:-8900}"
      JOBS: "${GUFO_JOBS:-2}"
      # Serve context window (tokens). Default 128K; model max is 262144
      # if VRAM allows. KV-cache memory scales with this value.
      GUFO_CONTEXT: "${GUFO_CONTEXT:-131072}"
      # Prefill tile (tokens). ~3 GiB scratch at 8192, ~9 GiB at 16384.
      GUFO_PREFILL_TILE: "${GUFO_PREFILL_TILE:-8192}"
      GUFO_EFFORT: "${GUFO_EFFORT:-low}"
      GUFO_NPU: "${GUFO_NPU:-0}"
      # Set NPU power mode at serve start (performance|balanced|default|powersaver).
      # Empty = leave host mode unchanged. Resets on every driver load / reboot.
      GUFO_NPU_PMODE: "${GUFO_NPU_PMODE:-}"
      XRT_DIR: "${XRT_DIR:-/opt/xilinx/xrt}"
      GUFO_CACHE_DIR: /root/.cache/gufo/snapshots
      GUFO_LOG: /root/.cache/gufo/gufo.log
      ROCM_PATH: /opt/rocm
    command: ["serve"]
    healthcheck:
      test:
        [
          "CMD-SHELL",
          "curl -sf http://127.0.0.1:${PORT:-8900}/v1/models >/dev/null",
        ]
      interval: 30s
      timeout: 10s
      retries: 10
      start_period: 10m
    restart: unless-stopped
    # Start only after weights exist: ./dc.sh download  (profile init)

volumes:
  flash-next-cache:
    name: flash-next-cache
